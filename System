<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>เกมระบบย่อยอาหาร</title>
<style>
*{box-sizing:border-box}html,body{margin:0;height:100%;font-family:Arial,"Noto Sans Thai",sans-serif;background:#071b2e;color:#fff}
.screen{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;padding:20px;text-align:center}
.active{display:flex}
#home{background:linear-gradient(160deg,#0b3150,#087f8c)}
h1{font-size:clamp(34px,9vw,60px);margin:8px 0}h2{font-size:30px}
p{font-size:18px;line-height:1.5}
button{border:0;border-radius:16px;padding:13px 18px;font-size:17px;font-weight:bold;cursor:pointer}
.primary{background:#ffe35c;color:#092033;box-shadow:0 4px 0 #a28e19}
#foodScreen{background:#eef7f8;color:#102334}
#picker{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;max-width:600px;margin:15px}
.food{background:white;color:#102334;min-width:135px}.food.selected{background:#ffe35c;outline:4px solid #102334}
#game{background:#000;padding:0;justify-content:flex-start}
#video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scaleX(-1)}
#overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.top{position:absolute;top:0;left:0;right:0;z-index:4;display:flex;justify-content:space-between;padding:12px;background:linear-gradient(#000b,transparent)}
.badge{background:#000a;border-radius:12px;padding:8px 11px;font-weight:bold}
#filterbar{position:absolute;bottom:15px;left:8px;right:8px;z-index:5;display:flex;gap:7px;justify-content:center;flex-wrap:wrap}
.filter{padding:9px 11px;font-size:14px;background:white;color:#102334}
.filter.selected{background:#ffe35c}
#start{position:absolute;bottom:92px;z-index:6}
#panel{position:absolute;bottom:8px;left:8px;right:8px;z-index:10;background:#071b2ef2;border:2px solid #ffffff44;border-radius:20px;padding:12px;display:none}
#panel.show{display:block}
#timer{font-size:25px;font-weight:bold;color:#ffe35c}
#question{font-size:18px;font-weight:bold;margin:5px}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.answer{font-size:14px;padding:10px;color:#102334;background:#fff;box-shadow:none}
#msg{position:absolute;z-index:20;top:45%;left:50%;transform:translate(-50%,-50%);background:#000d;padding:20px;border-radius:18px;font-size:24px;font-weight:bold;display:none}
.small{font-size:14px;opacity:.7}
</style>
</head>
<body>

<section id="home" class="screen active">
<div style="font-size:70px">🧬</div>
<h1>เกมระบบย่อยอาหาร</h1>
<p>เลือกอาหารของเจ้า แล้วเดินทางผ่านระบบย่อยอาหาร 5 ด่าน</p>
<button class="primary" onclick="openCamera()">เริ่มเกม</button>
<p class="small">ต้องอนุญาตให้เว็บไซต์ใช้กล้อง</p>
</section>

<section id="foodScreen" class="screen">
<h2>เลือกฟิลเตอร์</h2>
<p>มีเพียง 4 ฟิลเตอร์</p>
<div id="picker">
<button class="food" data-food="sticky" onclick="pick(this)">🍚 ข้าวเหนียว</button>
<button class="food" data-food="cabbage" onclick="pick(this)">🥬 กะหล่ำปลี</button>
<button class="food" data-food="chicken" onclick="pick(this)">🍗 ไก่ย่าง</button>
<button class="food" data-food="butter" onclick="pick(this)">🧈 เนย</button>
</div>
<button class="primary" onclick="begin()">ยืนยัน</button>
</section>

<section id="game" class="screen">
<video id="video" autoplay playsinline muted></video>
<canvas id="overlay"></canvas>
<div class="top"><div class="badge" id="stageName">ด่าน 1 — ปาก</div><div class="badge" id="score">คะแนน 0</div></div>
<div id="msg"></div>
<div id="filterbar">
<button class="filter" data-food="sticky" onclick="changeFood('sticky')">🍚 ข้าวเหนียว</button>
<button class="filter" data-food="cabbage" onclick="changeFood('cabbage')">🥬 กะหล่ำปลี</button>
<button class="filter" data-food="chicken" onclick="changeFood('chicken')">🍗 ไก่ย่าง</button>
<button class="filter" data-food="butter" onclick="changeFood('butter')">🧈 เนย</button>
</div>
<button id="start" class="primary" onclick="startStage()">เริ่มด่าน</button>
<div id="panel">
<div id="timer">10</div>
<p id="question"></p>
<div id="answers" class="answers"></div>
</div>
</section>

<section id="finish" class="screen" style="background:#0b3150">
<div style="font-size:70px">🏆</div><h1>ภารกิจสำเร็จ!</h1>
<p>ผ่านระบบย่อยอาหารครบ 5 ด่านแล้ว</p>
<h2 id="final">คะแนน 0</h2>
<button class="primary" onclick="location.reload()">เล่นใหม่</button>
</section>

<script>
const video=document.getElementById("video"),canvas=document.getElementById("overlay"),ctx=canvas.getContext("2d");
let stream=null,food="",stage=0,score=0,running=false,timer=null,time=10;

const names=["ปาก","หลอดอาหาร","กระเพาะอาหาร","ลำไส้เล็ก","ลำไส้ใหญ่"];

function show(id){document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));document.getElementById(id).classList.add("active")}
async function openCamera(){
 try{
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia) throw new Error();
  stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:"user"},audio:false});
  video.srcObject=stream;show("foodScreen");
 }catch(e){alert("เปิดกล้องไม่ได้ กรุณาอนุญาตกล้อง และเปิดเว็บผ่าน HTTPS หรือ localhost")}
}
function pick(b){document.querySelectorAll(".food").forEach(x=>x.classList.remove("selected"));b.classList.add("selected");food=b.dataset.food}
function changeFood(f){food=f;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("selected",x.dataset.food===f))}
function begin(){if(!food)return alert("กรุณาเลือกฟิลเตอร์");show("game");resize();update();requestAnimationFrame(draw)}
function resize(){canvas.width=innerWidth;canvas.height=innerHeight}
addEventListener("resize",resize);
function update(){
 document.getElementById("stageName").textContent=`ด่าน ${stage+1} — ${names[stage]}`;
 document.getElementById("score").textContent=`คะแนน ${score}`;
 document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("selected",x.dataset.food===food));
}
function draw(){
 if(document.getElementById("game").classList.contains("active")){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  let x=canvas.width/2,y=canvas.height*.38,s=Math.min(canvas.width*.28,160);
  ctx.textAlign="center";ctx.textBaseline="middle";
  ctx.font=s+"px serif";
  ctx.fillText(food==="sticky"?"🍚":food==="cabbage"?"🥬":food==="chicken"?"🍗":"🧈",x,y);
  if(food==="sticky"){ctx.font=s*.5+"px serif";ctx.fillText("🧺",x,y+s*.65)}
  if(food==="chicken"){ctx.strokeStyle="#b88a50";ctx.lineWidth=7;ctx.beginPath();ctx.moveTo(x-s*.65,y+s*.5);ctx.lineTo(x+s*.65,y-s*.5);ctx.stroke()}
 }
 requestAnimationFrame(draw)
}
function startStage(){
 if(running)return;running=true;document.getElementById("start").style.display="none";
 effect();
 setTimeout(question,1500);
}
function effect(){
 let start=Date.now();
 function a(){
  if(!running)return;
  if(stage===0){
   ctx.strokeStyle="#9beaff";ctx.lineWidth=7;
   for(let i=0;i<8;i++){let x=canvas.width*.15+i*canvas.width*.1,y=((Date.now()-start)/5+i*70)%(canvas.height*.5);ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x,y+45);ctx.stroke()}
  }else if(stage===1){
   let y=canvas.height*.2+(((Date.now()-start)/6)%300);ctx.strokeStyle="#ffb46b";ctx.lineWidth=18;ctx.beginPath();ctx.moveTo(canvas.width/2,y);ctx.lineTo(canvas.width/2,y+50);ctx.stroke()
  }
  requestAnimationFrame(a)
 }a()
}
function question(){
 let q="",opts=[],correct=0;
 if(stage===0&&food==="sticky"){
  q="เหตุใดเจ้าจึงละลายเช่นนี้?";
  opts=["ข้าถูกฟันบดและเอนไซม์อะไมเลสย่อย","ในนี้มันร้อนมาก ข้าจึงละลาย","ข้าถูกฟันบดอย่างเดียว ซึ่งเป็นการย่อยเชิงกล","ข้าถูกเอนไซม์อะไมเลสย่อยอย่างเดียว ซึ่งเป็นการย่อยเชิงเคมี"];correct=0;
 }else if(stage===0){
  q="เหตุใดเจ้าจึงถูกบดเช่นนี้?";
  opts=["ข้าถูกเอนไซม์อะไมเลสย่อย ซึ่งเป็นการย่อยเชิงเคมี","ข้าถูกเอนไซม์อะไมเลสย่อย ซึ่งเป็นการย่อยเชิงกล","ข้าถูกฟันบดอย่างเดียว ซึ่งเป็นการย่อยเชิงกล","ข้าถูกเอนไซม์อะไมเลสย่อยอย่างเดียว ซึ่งเป็นการย่อยเชิงเคมี"];correct=2;
 }else if(stage===1){
  q="เหตุใดเจ้าถึงกำลังจะร่วงเช่นนี้?";
  opts=["ข้าถูกเอนไซม์อะไมเลสย่อย ซึ่งเป็นการย่อยเชิงเคมี","ข้าถูกเอนไซม์อะไมเลสย่อย ซึ่งเป็นการย่อยเชิงกล","ข้าตกลงตามแรงโน้มถ่วง","ข้าถูกหลอดอาหารบีบและคลายตัวจึงเป็นเช่นนี้"];correct=3;
 }else if(stage===2){
  q="เหตุใดเจ้าจึงถูกย่อยเช่นนี้?";
  opts=["ข้าถูกเอนไซม์อะไมเลสย่อย","ข้าถูกเอนไซม์เพปซินช่วยย่อยโปรตีนในกระเพาะอาหาร","ข้าถูกน้ำลายย่อยจนหมด","ข้าถูกแรงโน้มถ่วงย่อย"];correct=1;
 }else if(stage===3){
  q="สารอาหารของเจ้าถูกดูดซึมที่ใด?";
  opts=["ปาก","กระเพาะอาหาร","ลำไส้เล็ก","ลำไส้ใหญ่"];correct=2;
 }else{
  q="เหตุใดน้ำจึงค่อย ๆ หายไปจากตัวข้า?";
  opts=["เพราะฟันกำลังบดข้า","เพราะน้ำลายกำลังย่อยข้า","เพราะกระเพาะอาหารกำลังบีบข้า","เพราะลำไส้ใหญ่ดูดซึมน้ำกลับเข้าสู่ร่างกาย"];correct=3;
 }
 document.getElementById("question").textContent=q;
 const box=document.getElementById("answers");box.innerHTML="";
 opts.forEach((t,i)=>{let b=document.createElement("button");b.className="answer";b.textContent=`${i+1}. ${t}`;b.onclick=()=>answer(i===correct);box.appendChild(b)});
 document.getElementById("panel").classList.add("show");
 time=10;document.getElementById("timer").textContent="10";
 timer=setInterval(()=>{time--;document.getElementById("timer").textContent=time;if(time<=0){clearInterval(timer);answer(false)}},1000)
}
function answer(ok){
 if(!running)return;clearInterval(timer);running=false;
 if(ok){score+=10;update();msg("✅ ถูกต้อง!");setTimeout(next,800)}
 else{msg("❌ ผิดหรือหมดเวลา! เริ่มด่านนี้ใหม่");setTimeout(()=>{hideMsg();document.getElementById("panel").classList.remove("show");document.getElementById("start").style.display="block"},1200)}
}
function next(){
 hideMsg();document.getElementById("panel").classList.remove("show");
 if(stage<4){stage++;update();document.getElementById("start").style.display="block"}
 else{document.getElementById("final").textContent=`คะแนน ${score}`;show("finish")}
}
function msg(t){let e=document.getElementById("msg");e.textContent=t;e.style.display="block"}
function hideMsg(){document.getElementById("msg").style.display="none"}
</script>
</body>
</html>
